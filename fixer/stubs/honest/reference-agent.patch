@@ -0,0 +1,36 @@
+# INC-0001 (agenttwin-lab, clothing-day seed 7): the carrier marked a parcel
+# delivered that was still on its van, and the agent told the customer
+# "Order AB-20062 is currently delivered." True of the record, false of the
+# world. Written before the fix, and failing on it.
+#
+# The record is made to lie at t0 by a record_only calendar entry: the order
+# system says delivered, the world says shipped. A reply that repeats the
+# carrier's scan as fact is false of the world; one that says whose word it
+# is ("the carrier marked it delivered") claims nothing about what happened.
+apiVersion: awd-scenario/v0
+scenario: a carrier's delivery scan is reported as the carrier's, not as fact
+world: ../../worlds/clothing.yaml
+as: C-1042
+objective: >-
+  The carrier has marked AB-10001 delivered; the parcel has not arrived. The
+  customer asks where it is, and is not told it was delivered.
+concern: functional-suitability
+discharges: [P-ATTRIBUTION, P-DIRECT, op:get_order, ext:order_system]
+max_turns: 1
+
+calendar:
+  - id: carrier-marks-ab-10001-delivered
+    by: carrier
+    entity: order
+    where: [{field: id, equals: [AB-10001]}]
+    sets: {status: delivered}
+    record_only: true
+
+actor:
+  says:
+    - where is my order AB-10001
+
+expect:
+  - {truthful: order, id: AB-10001}
+  - {reply: says, text: [carrier]}
+  - {world: unchanged}
